{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "dm:core",
      "is_summonable": true,
      "is_spawnable": false
    },
    "components": {
      "minecraft:type_family": { "family": ["dm_core"] },
      "minecraft:health": { "value": 200, "max": 200 },
      "minecraft:collision_box": { "width": 0.8, "height": 1.0 },
      "minecraft:physics": { "has_gravity": false, "has_collision": true },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:fire_immune": {},
      "minecraft:persistent": {},
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": false },
      "minecraft:scale": { "value": 0.6 },
      // Only DM attackers hurt the core. M0 checks whether arrows report the
      // skeleton or the arrow as "other"; entityHurt logs show which got through.
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "other", "value": "dm_attacker" },
                  { "test": "is_family", "subject": "damager", "value": "dm_attacker" }
                ]
              }
            },
            "deals_damage": "yes"
          },
          { "deals_damage": "no" }
        ]
      }
    }
  }
}
