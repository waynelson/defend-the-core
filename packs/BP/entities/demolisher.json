{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "dm:demolisher",
      "is_summonable": true,
      "is_spawnable": true
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "dm_attacker",
          "dm_boss",
          "creeper",
          "monster",
          "mob"
        ]
      },
      "minecraft:health": {
        "value": 150,
        "max": 150
      },
      "minecraft:movement": {
        "value": 0.18
      },
      "minecraft:follow_range": {
        "value": 64,
        "max": 64
      },
      "minecraft:collision_box": {
        "width": 1.2,
        "height": 3.4
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "dm_attacker"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "operator": "!=",
                  "value": "dm_guard"
                }
              ]
            }
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 6
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:can_climb": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "is_amphibious": true,
        "can_pass_doors": true
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "test": "in_lava"
            }
          }
        ]
      },
      "minecraft:attack": {
        "damage": 3
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 4,
        "track_target": true
      },
      "minecraft:behavior.swell": {
        "priority": 2,
        "start_distance": 2.5,
        "stop_distance": 6
      },
      "minecraft:target_nearby_sensor": {
        "inside_range": 2.5,
        "outside_range": 6,
        "must_see": true,
        "on_inside_range": {
          "event": "minecraft:start_exploding",
          "target": "self"
        },
        "on_outside_range": {
          "event": "minecraft:stop_exploding",
          "target": "self"
        },
        "on_vision_lost_inside_range": {
          "event": "minecraft:stop_exploding",
          "target": "self"
        }
      },
      "minecraft:scale": {
        "value": 2.0
      },
      "minecraft:boss": {
        "should_darken_sky": false,
        "hud_range": 64
      },
      "minecraft:knockback_resistance": {
        "value": 0.9
      }
    },
    "component_groups": {
      "dm:tgt_core_only": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "dm_core"
              },
              "max_dist": 64,
              "must_see": false
            }
          ]
        }
      },
      "dm:tgt_prioritized": {
        "minecraft:behavior.nearest_prioritized_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "dm_core"
              },
              "max_dist": 64,
              "must_see": false,
              "priority": 0
            },
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "dm_turret"
              },
              "max_dist": 8,
              "must_see": true,
              "priority": 1
            },
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 6,
              "must_see": true,
              "priority": 2
            }
          ]
        }
      },
      "dm:tgt_nearest": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "dm_core"
              },
              "max_dist": 64,
              "must_see": false
            },
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "dm_turret"
              },
              "max_dist": 8,
              "must_see": true
            },
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 6,
              "must_see": true
            }
          ]
        }
      },
      "dm:exploding": {
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 7,
          "causes_fire": false,
          "breaks_blocks": true,
          "destroy_affected_by_griefing": false
        }
      },
      "dm:detonating": {
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 7,
          "causes_fire": false,
          "breaks_blocks": true,
          "destroy_affected_by_griefing": false
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "dm:tgt_prioritized"
          ]
        }
      },
      "dm:tgt_core_only": {
        "remove": {
          "component_groups": [
            "dm:tgt_prioritized",
            "dm:tgt_nearest"
          ]
        },
        "add": {
          "component_groups": [
            "dm:tgt_core_only"
          ]
        }
      },
      "dm:tgt_prioritized": {
        "remove": {
          "component_groups": [
            "dm:tgt_core_only",
            "dm:tgt_nearest"
          ]
        },
        "add": {
          "component_groups": [
            "dm:tgt_prioritized"
          ]
        }
      },
      "dm:tgt_nearest": {
        "remove": {
          "component_groups": [
            "dm:tgt_core_only",
            "dm:tgt_prioritized"
          ]
        },
        "add": {
          "component_groups": [
            "dm:tgt_nearest"
          ]
        }
      },
      "minecraft:start_exploding": {
        "add": {
          "component_groups": [
            "dm:exploding"
          ]
        }
      },
      "minecraft:stop_exploding": {
        "remove": {
          "component_groups": [
            "dm:exploding"
          ]
        }
      },
      "dm:detonate": {
        "add": {
          "component_groups": [
            "dm:detonating"
          ]
        }
      }
    }
  }
}
